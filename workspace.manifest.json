      "scope": "public",
      "required": false
    },
    {
      "name": "VAPID_PRIVATE_KEY",
      "scope": "server",
      "required": false
    },
    {
      "name": "VAPID_SUBJECT",
      "scope": "server",
      "required": false
    },
    {
      "name": "FORTNITE_TRACKER_SEARCH_ENDPOINT",
