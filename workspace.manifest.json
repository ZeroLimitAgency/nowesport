    "src/workspace/overlays/renderer/",
    "src/app/workspace/overlays/",
    "src/app/overlay/",
    "src/app/api/overlays/"
  ],
  "nowSpecificPaths": [
    "src/workspace/now",
    "src/workspace/overlays/now/"
  ],
  "fortniteSpecificPaths": [
    "src/workspace/games/fortnite",
    "src/app/workspace/fortnite",
    "src/app/workspace/fortnite/live",
    "src/components/twitch-connect.tsx"
  ],
  "twitchSpecificPaths": [
    "src/workspace/streaming/twitch",
    "src/app/api/integrations/twitch/eventsub"
  ],
  "databaseTables": [
    "stream_accounts",
    "stream_sessions",
    "stream_snapshots",
    "stream_goals",
    "integration_subscriptions",
    "webhook_events",
    "notifications",
