    "OVERLAY_HEARTBEAT_INTERVAL_SECONDS",
    "OVERLAY_RUNTIME_REFRESH_SECONDS"
  ],
  "storageBuckets": [
    {
      "name": "overlays",
      "access": "public-non-sensitive-assets",
      "mimeTypes": [
        "image/png",
        "image/jpeg",
        "image/webp",
        "video/mp4",
        "video/webm"
      ]
    }
  ],
  "integrations": [
    {
      "id": "fortnite_tracker",
      "status": "contract-required"
    },
    {
      "id": "twitch",
      "status": "configuration-required"
    },
    {
      "id": "web_push",
      "status": "vapid-and-transport-required"
    }
  ],
  "scheduledJobs": [
    {
      "id": "fortnite-tracker-sync",
      "entrypoint": "syncTrackedFortnitePlayers",
      "status": "prepared-not-scheduled"
    },
    {
      "id": "stream-snapshot-capture",
      "entrypoint": "captureActiveStreamSnapshots",
      "status": "prepared-not-scheduled",
      "recommendedIntervalMinutes": 5
    },
    {
      "id": "overlay-campaign-scheduler",
      "entrypoint": "applyScheduledOverlayCampaigns",
      "status": "prepared-not-scheduled"
    }
  ],
  "webhooks": [
    {
      "id": "twitch-eventsub",
      "route": "/api/integrations/twitch/eventsub",
      "transport": "webhook",
      "status": "configuration-required"
    }
  ],
  "portablePaths": [
    "src/workspace/core",
    "src/components/workspace-shell.tsx",
    "src/app/workspace",
    "docs/workspace",
    "supabase/migrations/20260809_workspace_core_foundations.sql",
