    },
    {
      "name": "FORTNITE_TRACKER_MAX_RETRIES",
      "scope": "server",
      "required": false
    },
    {
      "name": "FORTNITE_TRACKER_CACHE_TTL_SECONDS",
      "scope": "server",
      "required": false
