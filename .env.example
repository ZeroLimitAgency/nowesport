# Public site
NEXT_PUBLIC_SITE_URL=https://nowesport.org
NEXT_PUBLIC_HERO_VIDEO_URL=

# Maintenance fallback
# Source of truth: Supabase public.site_settings.maintenance_mode when Supabase is reachable.
# This env is only the fail-safe fallback if Supabase settings cannot be read.
# Publication: set Supabase maintenance_mode=false, then keep this as off only after the public site has been verified.
NEXT_PUBLIC_MAINTENANCE_MODE=off

# Admin preview
# Optional emergency preview token for /api/admin/preview?token=...&next=/.
# Generate a long random value in production. Leave empty to disable token preview and use Supabase admin role only.
PREVIEW_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# Stripe
# Use test keys for staging and real live keys only after an end-to-end checkout/webhook test on the production domain.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Workspace integrations (optional; server-only unless prefixed NEXT_PUBLIC_)
FORTNITE_TRACKER_API_KEY=
FORTNITE_TRACKER_API_BASE_URL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
FORTNITE_TRACKER_SEARCH_ENDPOINT=
FORTNITE_TRACKER_PROFILE_ENDPOINT=
FORTNITE_TRACKER_PR_ENDPOINT=
FORTNITE_TRACKER_MATCHES_ENDPOINT=
FORTNITE_TRACKER_HISTORY_ENDPOINT=
FORTNITE_TRACKER_LEADERBOARD_ENDPOINT=
FORTNITE_TRACKER_TIMEOUT_MS=8000
FORTNITE_TRACKER_MAX_RETRIES=2
FORTNITE_TRACKER_CACHE_TTL_SECONDS=300
FORTNITE_TRACKER_MIN_REQUEST_INTERVAL_MS=250
FORTNITE_TRACKER_SYNC_INTERVAL_ACTIVE=60
FORTNITE_TRACKER_SYNC_INTERVAL_SCOUTING=360
FORTNITE_TRACKER_SYNC_BATCH_SIZE=20

# Twitch Live Center (server-only except where explicitly public)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=
TWITCH_EVENTSUB_CALLBACK_URL=
TWITCH_EVENTSUB_TRANSPORT=webhook
TWITCH_API_TIMEOUT_MS=8000
TWITCH_API_MAX_RETRIES=2
STREAM_SNAPSHOT_INTERVAL_MINUTES=5

# Overlay Cloud tuning (optional)
OVERLAY_HEARTBEAT_INTERVAL_SECONDS=60
OVERLAY_RUNTIME_REFRESH_SECONDS=5
