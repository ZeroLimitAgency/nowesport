# Public site
NEXT_PUBLIC_SITE_URL=https://nowesport.org
NEXT_PUBLIC_HERO_VIDEO_URL=

# Maintenance fallback
# Keep unset/on for public maintenance. Set to off to bypass maintenance if Supabase site_settings is unavailable.
NEXT_PUBLIC_MAINTENANCE_MODE=on

# Admin preview
# PREVIEW_SECRET enables /api/admin/preview?token=...
PREVIEW_SECRET=change-me-preview-secret
# Optional fallback list. Real admins are primarily read from public.profiles.role = 'admin'.
ADMIN_PREVIEW_EMAILS=admin@nowesport.org

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# Stripe placeholders (do not switch to live checkout until final Stripe phase)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
