# Public site
NEXT_PUBLIC_SITE_URL=https://nowesport.org
NEXT_PUBLIC_HERO_VIDEO_URL=

# Maintenance fallback
# Source of truth: Supabase public.site_settings.maintenance_mode when Supabase is reachable.
# This env is only the fail-safe fallback if Supabase settings cannot be read.
# Publication: set Supabase maintenance_mode=false, then keep this as off only after the public site has been verified.
NEXT_PUBLIC_MAINTENANCE_MODE=off

# Admin preview
# Optional emergency preview token for /api/admin/preview?token=...&next=/.
# Generate a long random value in production. Leave empty to disable token preview and use Supabase admin role only.
PREVIEW_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# Stripe
# Use test keys for staging and real live keys only after an end-to-end checkout/webhook test on the production domain.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
