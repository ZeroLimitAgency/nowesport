{
  "name": "nowesport",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check": "npm run lint && npm run build",
    "test": "npm run test:workspace && npm run test:fortnite && npm run test:live && npm run test:overlays && npm run test:seo",
    "test:seo": "npm run build && node --experimental-strip-types --test --test-concurrency=1 tests/seo/*.test.mjs",
    "test:workspace": "node --test tests/workspace/*.test.mjs",
    "test:fortnite": "node --experimental-strip-types --test tests/fortnite/*.test.mjs",
    "test:live": "node --experimental-strip-types --test tests/live/*.test.mjs",
    "test:overlays": "node --experimental-strip-types --test tests/overlays/*.test.mjs"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.5.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
